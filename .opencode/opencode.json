{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["./plugins/agentmemory-capture.ts"],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true,
      "environment": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      }
    }
  }
}
