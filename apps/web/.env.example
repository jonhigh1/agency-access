# Frontend Environment Variables

# API URL for the backend Fastify server
# Development: http://localhost:3001
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# App URL for the frontend Next.js server (used for OAuth callbacks)
# Development: http://localhost:3000
# Production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta Business Login (public browser config)
# App ID from Meta for Developers > App Settings > Basic
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
# Config ID from Facebook Login for Business > Configurations
NEXT_PUBLIC_META_LOGIN_FOR_BUSINESS_CONFIG_ID=your_meta_business_login_config_id
# Server-side rollout controls live in apps/api; this public ID only configures client login.

# Docs URL for the standalone Docusaurus help center
# Development: http://localhost:3002
# Production: https://docs.authhub.co
NEXT_PUBLIC_DOCS_URL=https://docs.authhub.co

# Clerk Authentication Keys
# Get these from your Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
CLERK_SECRET_KEY=sk_live_your_secret_key_here

# Meta App Review Lab (/review-demo — enable only on review.authhub.co)
NEXT_PUBLIC_META_REVIEW_DEMO_ENABLED=false
NEXT_PUBLIC_META_REVIEW_LAB_USER_IDS=

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/unified

# PostHog Analytics (https://posthog.com/docs/libraries/js)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional deployment label (e.g. staging): registered as the PostHog `environment` super-property.
# Unset or production = unchanged.
NEXT_PUBLIC_APP_ENV=
# Set to 'true' to send events when running on localhost (default: do not send in dev)
# NEXT_PUBLIC_POSTHOG_SEND_IN_DEV=false

# Help Scout Beacon widget
# Leave blank to disable the in-app Beacon widget.
NEXT_PUBLIC_HELPSCOUT_BEACON_ID=

# Development Flags
# Set to 'true' to bypass Clerk authentication in local development
# Useful for browser automation, visual testing, and screenshot workflows
# See: apps/web/DEV_AUTH_SETUP.md for complete guide
# WARNING: Only works in NODE_ENV=development, never use in production
NEXT_PUBLIC_BYPASS_AUTH=false

# Optional Sentry environment tag (e.g. staging). Unset = NODE_ENV.
# SENTRY_ENVIRONMENT is read on the server/edge; the browser bundle only sees NEXT_PUBLIC_SENTRY_ENVIRONMENT.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
