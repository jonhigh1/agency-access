// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Agencies
model Agency {
  id               String  @id @default(uuid())
  clerkUserId      String? @unique @map("clerk_user_id")
  name             String
  email            String  @unique
  subscriptionTier String? @map("subscription_tier")
  settings         Json?

  // Notification settings
  notificationEmail   String? @map("notification_email")
  notificationEnabled Boolean @default(true) @map("notification_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members             AgencyMember[]
  accessRequests      AccessRequest[]
  connections         ClientConnection[]
  auditLogs           AuditLog[]
  platformConnections AgencyPlatformConnection[]
  clients             Client[]
  templates           AccessRequestTemplate[]
  usageCounters       AgencyUsageCounter[]
  subscription        Subscription?
  affiliateReferral   AffiliateReferral?
  webhookEndpoints    WebhookEndpoint[]
  webhookEvents       WebhookEvent[]
  metaDestinations    MetaAgencyDestination[]
  agentGrants            AgentGrant[]
  agentOperations        AgentOperation[]
  googleOffboardingRuns  GoogleOffboardingRun[]

  @@map("agencies")
}

// Agency team members
model AgencyMember {
  id        String    @id @default(uuid())
  agencyId  String    @map("agency_id")
  email     String
  role      String // 'admin', 'member', 'viewer'
  invitedAt DateTime  @default(now()) @map("invited_at")
  joinedAt  DateTime? @map("joined_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, email])
  @@map("agency_members")
}

// Agency platform connections (agency's own OAuth connections OR identity-only connections)
model AgencyPlatformConnection {
  id       String @id @default(uuid())
  agencyId String @map("agency_id")
  platform String // Platform identifier: group-level ('google', 'meta') or product-level ('google_ads', 'ga4', 'meta_ads', 'linkedin')

  // Connection mode: 'oauth' (token-based) or 'identity' (email/Business ID only)
  connectionMode String @default("oauth") @map("connection_mode") // 'oauth' | 'identity'

  // OAuth token storage (nullable for identity mode)
  secretId String? @map("secret_id") // Infisical secret name
  status   String // 'active', 'expired', 'invalid', 'revoked'

  // OAuth metadata (nullable for identity mode)
  expiresAt       DateTime? @map("expires_at")
  lastRefreshedAt DateTime? @map("last_refreshed_at")
  scope           String? // Comma-separated scopes

  // Identity storage (for platform-native authorization flow)
  agencyEmail String? @map("agency_email") // For Google, LinkedIn
  businessId  String? @map("business_id") // For Meta Business Manager

  // Identity verification status
  verificationStatus String?   @map("verification_status") // 'pending' | 'verified' | 'failed'
  lastVerifiedAt     DateTime? @map("last_verified_at")
  verificationError  String?   @map("verification_error") @db.Text

  // Platform-specific data (Business ID, Ad Account ID, etc.)
  metadata Json?

  // Audit trail
  connectedBy String    @map("connected_by") // Email of user who connected
  connectedAt DateTime  @default(now()) @map("connected_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")

  agency                 Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  metaAgencyDestinations MetaAgencyDestination[]

  @@unique([agencyId, platform])
  @@index([agencyId, status])
  @@index([agencyId, connectionMode])
  @@map("agency_platform_connections")
}

// Clients (reusable client profiles)
model Client {
  id        String   @id @default(uuid())
  agencyId  String   @map("agency_id")
  name      String // Contact person name
  company   String // Company name
  email     String
  website   String?
  language  String   @default("en") // 'en', 'es', 'nl', etc.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency         Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]

  @@unique([agencyId, email])
  @@map("clients")
}

// Access Request Templates - agency-wide reusable templates
model AccessRequestTemplate {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  name         String
  description  String?  @db.Text
  platforms    Json // Hierarchical format: { google: ['google_ads', 'ga4'] }
  intakeFields Json     @map("intake_fields")
  branding     Json?
  isDefault    Boolean  @default(false) @map("is_default")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, name])
  @@index([agencyId, isDefault])
  @@map("access_request_templates")
}

// Access requests created by agencies
model AccessRequest {
  id                String    @id @default(uuid())
  agencyId          String    @map("agency_id")
  clientId          String?   @map("client_id")
  clientName        String    @map("client_name")
  clientEmail       String    @map("client_email")
  externalReference String?   @map("external_reference")
  platforms         Json // Platform configuration with groups, products, access levels
  status            String // 'pending', 'partial', 'completed', 'expired', 'revoked'
  uniqueToken       String    @unique @map("unique_token")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  intakeFields      Json?     @map("intake_fields") // Custom form fields for client intake
  branding          Json? // Custom branding (logo, colors, subdomain)
  metaAccessConfig  Json?     @map("meta_access_config")
  authorizedAt      DateTime? @map("authorized_at") // When client completed authorization

  agency             Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  client             Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  connection         ClientConnection?
  googleNativeGrants GoogleNativeGrant[]
  metaAssetGrants    MetaAssetGrant[]

  @@index([agencyId, status])
  @@index([agencyId, createdAt])
  @@index([agencyId, externalReference])
  @@index([clientId, createdAt])
  @@map("access_requests")
}

model WebhookEndpoint {
  id                  String    @id @default(uuid())
  agencyId            String    @map("agency_id")
  url                 String
  secretId            String    @map("secret_id")
  status              String // 'active' | 'disabled'
  subscribedEvents    Json      @map("subscribed_events")
  preferredApiVersion String    @default("2026-03-08") @map("preferred_api_version")
  failureCount        Int       @default(0) @map("failure_count")
  lastDeliveredAt     DateTime? @map("last_delivered_at")
  lastFailedAt        DateTime? @map("last_failed_at")
  disabledAt          DateTime? @map("disabled_at")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  events     WebhookEvent[]
  deliveries WebhookDelivery[]

  @@unique([agencyId])
  @@index([agencyId, status])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  agencyId     String   @map("agency_id")
  endpointId   String   @map("endpoint_id")
  type         String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at")

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  endpoint   WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([agencyId, type])
  @@index([endpointId, createdAt])
  @@map("webhook_events")
}

model WebhookDelivery {
  id                  String    @id @default(uuid())
  endpointId          String    @map("endpoint_id")
  eventId             String    @map("event_id")
  attemptNumber       Int       @default(1) @map("attempt_number")
  status              String // 'pending' | 'delivered' | 'failed'
  requestHeaders      Json?     @map("request_headers")
  responseStatus      Int?      @map("response_status")
  responseBodySnippet String?   @map("response_body_snippet") @db.Text
  errorCode           String?   @map("error_code")
  errorMessage        String?   @map("error_message") @db.Text
  nextAttemptAt       DateTime? @map("next_attempt_at")
  deliveredAt         DateTime? @map("delivered_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event    WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, attemptNumber])
  @@index([endpointId, status, createdAt])
  @@index([eventId, status])
  @@map("webhook_deliveries")
}

// Client connections (after authorization)
model ClientConnection {
  id              String    @id @default(uuid())
  accessRequestId String    @unique @map("access_request_id")
  agencyId        String    @map("agency_id")
  clientEmail     String    @map("client_email")
  status          String // 'active', 'revoked', 'expired'
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")
  revokedBy       String?   @map("revoked_by")

  // Granted assets from client (for partner access model)
  // Format: { adAccounts: [{id, name}], pages: [{id, name}], instagramAccounts: [{id, username}] }
  grantedAssets Json? @map("granted_assets")

  accessRequest      AccessRequest           @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  agency             Agency                  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  authorizations         PlatformAuthorization[]
  googleNativeGrants     GoogleNativeGrant[]
  googleOffboardingRuns  GoogleOffboardingRun[]
  metaAssetGrants        MetaAssetGrant[]

  @@index([agencyId, status])
  @@index([agencyId, createdAt])
  @@map("client_connections")
}

// Platform-specific authorizations
model PlatformAuthorization {
  id              String    @id @default(uuid())
  connectionId    String    @map("connection_id")
  platform        String // Platform identifier: group-level ('google', 'meta') or product-level ('google_ads', 'ga4', 'meta_ads', 'linkedin')
  secretId        String    @map("secret_id") // AWS Secrets Manager ID
  expiresAt       DateTime? @map("expires_at")
  lastRefreshedAt DateTime? @map("last_refreshed_at")
  status          String // 'active', 'expired', 'invalid', 'revoked'
  metadata        Json? // platform-specific data
  createdAt       DateTime  @default(now()) @map("created_at")

  connection      ClientConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  metaAssetGrants MetaAssetGrant[]

  @@unique([connectionId, platform])
  @@index([connectionId, status])
  @@map("platform_authorizations")
}

// Audit logs for security tracking
model AuditLog {
  id                 BigInt   @id @default(autoincrement())
  agencyId           String?  @map("agency_id")
  userEmail          String?  @map("user_email")
  action             String // 'token_viewed', 'access_granted', 'access_revoked', 'AGENCY_CONNECTED', 'AGENCY_DISCONNECTED', 'AGENCY_TOKEN_REFRESHED'
  resourceType       String?  @map("resource_type")
  resourceId         String?  @map("resource_id")
  agencyConnectionId String?  @map("agency_connection_id")
  metadata           Json?
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  actorType          String?  @map("actor_type")
  actorId            String?  @map("actor_id")
  agentGrantId       String?  @map("agent_grant_id")
  agentOperationId   String?  @map("agent_operation_id")
  oauthClientId      String?  @map("oauth_client_id")
  createdAt          DateTime @default(now()) @map("created_at")

  agency         Agency?         @relation(fields: [agencyId], references: [id])
  agentGrant     AgentGrant?     @relation(fields: [agentGrantId], references: [id], onDelete: SetNull)
  agentOperation AgentOperation? @relation(fields: [agentOperationId], references: [id], onDelete: SetNull)

  @@index([action, resourceId])
  @@index([agencyId, createdAt])
  @@index([agentGrantId, createdAt])
  @@index([agentOperationId, createdAt])
  @@map("audit_logs")
}

// External personal-agent grants. Provider tokens and secret references never belong here.
model AgentGrant {
  id            String    @id @default(uuid())
  agencyId      String    @map("agency_id")
  ownerSubject  String    @map("owner_subject")
  oauthClientId String    @map("oauth_client_id")
  displayName   String    @map("display_name")
  permissions   Json
  state         String    @default("active")
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedBy     String?   @map("revoked_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  agency     Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  operations AgentOperation[]
  auditLogs  AuditLog[]

  @@unique([agencyId, ownerSubject, oauthClientId])
  @@index([agencyId, state])
  @@index([oauthClientId, state])
  @@map("agent_grants")
}

// Durable approval and execution state for agent-initiated actions.
model AgentOperation {
  id                 String    @id @default(uuid())
  grantId            String    @map("grant_id")
  agencyId           String    @map("agency_id")
  actionType         String    @map("action_type")
  riskClass          String    @map("risk_class")
  inputSnapshot      Json      @map("input_snapshot")
  inputHash          String    @map("input_hash")
  approvalPreview    Json?     @map("approval_preview")
  idempotencyKey     String    @map("idempotency_key")
  status             String
  decidedBy          String?   @map("decided_by")
  decidedAt          DateTime? @map("decided_at")
  executionStartedAt DateTime? @map("execution_started_at")
  completedAt        DateTime? @map("completed_at")
  result             Json?
  failureCode        String?   @map("failure_code")
  failureMessage     String?   @map("failure_message") @db.Text
  retryable          Boolean   @default(false)
  expiresAt          DateTime? @map("expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  grant     AgentGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  agency    Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@unique([grantId, idempotencyKey])
  @@index([agencyId, status, createdAt])
  @@index([grantId, status, createdAt])
  @@index([status, expiresAt])
  @@map("agent_operations")
}

// Authorization verification tracking (for platform-native identity flow)
model AuthorizationVerification {
  id              String @id @default(uuid())
  accessRequestId String @map("access_request_id")
  platform        String // 'meta_ads', 'google_ads', 'ga4', etc.
  connectionId    String @map("connection_id") // ClientConnection.id

  // Verification attempt tracking
  status        String // 'pending' | 'verifying' | 'verified' | 'failed'
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  verifiedAt    DateTime? @map("verified_at")

  // Agency connection used for verification (must have OAuth token)
  agencyConnectionId String @map("agency_connection_id")

  // Verification results
  verifiedPermissions Json?   @map("verified_permissions") // { granted: boolean, level: string, accounts: string[] }
  errorMessage        String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([connectionId, platform])
  @@index([accessRequestId, status])
  @@map("authorization_verifications")
}

model GoogleNativeGrant {
  id                   String    @id @default(uuid())
  accessRequestId      String    @map("access_request_id")
  connectionId         String    @map("connection_id")
  product              String
  assetId              String    @map("asset_id")
  assetName            String?   @map("asset_name")
  grantMode            String    @map("grant_mode")
  requestedRole        String?   @map("requested_role")
  recipientEmail       String?   @map("recipient_email")
  managerCustomerId    String?   @map("manager_customer_id")
  providerResourceName String?   @map("provider_resource_name")
  providerExternalId   String?   @map("provider_external_id")
  nativeGrantState     String    @map("native_grant_state")
  lastAttemptAt        DateTime? @map("last_attempt_at")
  verifiedAt           DateTime? @map("verified_at")
  lastErrorCode        String?   @map("last_error_code")
  lastErrorMessage     String?   @map("last_error_message") @db.Text
  metadata             Json?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  accessRequest AccessRequest    @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  connection    ClientConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  offboardingItems GoogleOffboardingItem[]

  @@unique([connectionId, product, assetId, grantMode])
  @@index([accessRequestId, product, createdAt])
  @@index([connectionId, nativeGrantState, updatedAt])
  @@index([product, nativeGrantState, updatedAt])
  @@map("google_native_grants")
}

model GoogleOffboardingRun {
  id                   String    @id @default(uuid())
  agencyId             String    @map("agency_id")
  connectionId         String    @map("connection_id")
  status               String // "prepared | awaiting_approval | queued | executing | receipt_pending | completed | completed_with_manual_follow_up | incomplete | canceled"
  idempotencyKey       String    @unique @map("idempotency_key")
  snapshotHash         String    @map("snapshot_hash")
  credentialGeneration String?   @map("credential_generation")
  approvedById         String?   @map("approved_by_id")
  approvedAt           DateTime? @map("approved_at")
  finalOutcome         String?   @map("final_outcome") // "completed | completed_with_manual_follow_up | incomplete | canceled"
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  agency   Agency                   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  connection ClientConnection       @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  items    GoogleOffboardingItem[]
  attempts GoogleOffboardingAttempt[]

  @@index([agencyId, createdAt])
  @@index([connectionId, status])
  @@map("google_offboarding_runs")
}

model GoogleOffboardingItem {
  id               String    @id @default(uuid())
  runId            String    @map("run_id")
  productId        String    @map("product_id")
  classification   String // "eligible_automatic | manual_action_required | not_safely_reversible | reconnect_required"
  status           String // "pending | revoked_verified | already_absent | awaiting_client_approval | manual_action_required | reconnect_required | not_safely_reversible | failed_retryable | failed_terminal | attestation_recorded"
  assetLabel       String    @map("asset_label")
  grantId          String?   @map("grant_id")
  providerOutcome  String?   @map("provider_outcome") // "deleted | already_absent | approval_pending | manual_handoff | reconnect_required | transient_failure | terminal_failure | verification_failed"
  providerRequestId String? @map("provider_request_id")
  reason           String?   @db.Text
  attestedById     String?   @map("attested_by_id")
  attestedAt       DateTime? @map("attested_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  run      GoogleOffboardingRun   @relation(fields: [runId], references: [id], onDelete: Restrict)
  grant    GoogleNativeGrant?    @relation(fields: [grantId], references: [id], onDelete: Restrict)
  attempts GoogleOffboardingAttempt[]

  @@unique([runId, productId, assetLabel])
  @@index([runId, productId])
  @@index([grantId])
  @@map("google_offboarding_items")
}

model GoogleOffboardingAttempt {
  id                     String   @id @default(uuid())
  itemId                 String   @map("item_id")
  runId                  String   @map("run_id")
  action                 String // "provider_call | verification | secret_cleanup | attestation"
  providerOutcome        String?  @map("provider_outcome")
  requestId              String?  @map("request_id")
  responseClassification String? @map("response_classification") // "success | transient_failure | terminal_failure | verification_failed"
  errorCode              String?  @map("error_code")
  errorMessage           String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at")

  item GoogleOffboardingItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  run  GoogleOffboardingRun  @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([runId, createdAt])
  @@map("google_offboarding_attempts")
}

model MetaAgencyDestination {
  id                   String    @id @default(uuid())
  agencyId             String    @map("agency_id")
  agencyConnectionId   String    @map("agency_connection_id")
  businessId           String    @map("business_id")
  name                 String
  isDefault            Boolean   @default(false) @map("is_default")
  readinessStatus      String    @default("action_needed") @map("readiness_status")
  readinessDetails     Json?     @map("readiness_details")
  lastReadinessCheckAt DateTime? @map("last_readiness_check_at")
  lastVerifiedAt       DateTime? @map("last_verified_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  agency           Agency                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyConnection AgencyPlatformConnection @relation(fields: [agencyConnectionId], references: [id], onDelete: Cascade)
  grants           MetaAssetGrant[]

  @@unique([agencyId, businessId])
  @@index([agencyId, readinessStatus])
  @@index([agencyConnectionId])
  @@map("meta_agency_destinations")
}

model MetaAssetGrant {
  id               String    @id @default(uuid())
  accessRequestId  String    @map("access_request_id")
  connectionId     String    @map("connection_id")
  authorizationId  String?   @map("authorization_id")
  destinationId    String    @map("destination_id")
  clientBusinessId String    @map("client_business_id")
  recipeId         String    @map("recipe_id")
  recipeVersion    Int       @map("recipe_version")
  assetKind        String    @map("asset_kind")
  assetId          String    @map("asset_id")
  assetName        String?   @map("asset_name")
  requestedTasks   Json      @map("requested_tasks")
  verifiedTasks    Json?     @map("verified_tasks")
  grantMethod      String    @map("grant_method")
  status           String
  attemptVersion   Int       @default(1) @map("attempt_version")
  lastErrorCode    String?   @map("last_error_code")
  lastErrorMessage String?   @map("last_error_message") @db.Text
  nextActor        String?   @map("next_actor")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  grantedAt        DateTime? @map("granted_at")
  verifiedAt       DateTime? @map("verified_at")
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  accessRequest AccessRequest          @relation(fields: [accessRequestId], references: [id], onDelete: Cascade)
  connection    ClientConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  authorization PlatformAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  destination   MetaAgencyDestination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([accessRequestId, destinationId, clientBusinessId, assetKind, assetId])
  @@index([accessRequestId, status])
  @@index([connectionId, status])
  @@index([destinationId, status])
  @@index([authorizationId])
  @@map("meta_asset_grants")
}

// Agency usage counters for quota tracking
model AgencyUsageCounter {
  id                String    @id @default(uuid())
  agencyId          String    @map("agency_id")
  metricType        String    @map("metric_type") // 'client_onboards', 'platform_audits', 'team_seats'
  period            String // 'current_year', 'all_time'
  count             Int       @default(0)
  resetAt           DateTime? @map("reset_at")
  lastIncrementedAt DateTime  @default(now()) @map("last_incremented_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, metricType, period])
  @@index([agencyId, metricType])
  @@map("agency_usage_counters")
}

// ============================================================
// SUBSCRIPTION AND BILLING MODELS
// ============================================================

model Subscription {
  id       String @id @default(uuid())
  agencyId String @map("agency_id")

  // Creem integration fields
  creemCustomerId     String? @map("creem_customer_id")
  creemSubscriptionId String? @map("creem_subscription_id")

  // Subscription details
  tier   String @default("STARTER") // 'STARTER', 'GROWTH', 'SCALE'
  status String @default("active") // 'active', 'canceled', 'past_due', 'incomplete', 'incomplete_expired'

  // Billing cycle
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")

  // Trial and discounts
  trialStart DateTime? @map("trial_start")
  trialEnd   DateTime? @map("trial_end")

  // Metadata
  creemData Json? @map("creem_data") // Store full Creem subscription object

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agency               Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invoices             Invoice[]
  affiliateCommissions AffiliateCommission[]

  @@unique([agencyId])
  @@index([status])
  @@map("subscriptions")
}

model Invoice {
  id             String @id @default(uuid())
  subscriptionId String @map("subscription_id")

  // Creem integration
  creemInvoiceId String @unique @map("creem_invoice_id")

  // Invoice details
  amount   Int // Store in cents
  currency String @default("usd")
  status   String // 'draft', 'open', 'paid', 'void', 'uncollectible'

  // Dates
  invoiceDate DateTime? @map("invoice_date")
  dueDate     DateTime? @map("due_date")
  paidAt      DateTime? @map("paid_at")

  // Links
  invoiceUrl    String? @map("invoice_url")
  invoicePdfUrl String? @map("invoice_pdf_url")

  // Metadata
  creemData Json? @map("creem_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription        Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  affiliateCommission AffiliateCommission?

  @@index([subscriptionId, status])
  @@map("invoices")
}

model AffiliatePartner {
  id                       String    @id @default(uuid())
  clerkUserId              String?   @unique @map("clerk_user_id")
  email                    String    @unique
  name                     String
  companyName              String?   @map("company_name")
  websiteUrl               String?   @map("website_url")
  audienceSize             String?   @map("audience_size")
  status                   String    @default("applied")
  notes                    String?   @db.Text
  defaultCommissionBps     Int       @default(3000) @map("default_commission_bps")
  commissionDurationMonths Int       @default(12) @map("commission_duration_months")
  payoutMethod             String?   @map("payout_method")
  payoutDetails            Json?     @map("payout_details")
  appliedAt                DateTime  @default(now()) @map("applied_at")
  approvedAt               DateTime? @map("approved_at")
  rejectedAt               DateTime? @map("rejected_at")
  disabledAt               DateTime? @map("disabled_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  links       AffiliateLink[]
  clicks      AffiliateClick[]
  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]

  @@index([status, appliedAt])
  @@map("affiliate_partners")
}

model AffiliateLink {
  id              String   @id @default(uuid())
  partnerId       String   @map("partner_id")
  code            String   @unique
  destinationPath String   @default("/") @map("destination_path")
  campaign        String?
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  partner   AffiliatePartner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  clicks    AffiliateClick[]
  referrals AffiliateReferral[]

  @@index([partnerId, status])
  @@map("affiliate_links")
}

model AffiliateClick {
  id            String   @id @default(uuid())
  partnerId     String   @map("partner_id")
  linkId        String   @map("link_id")
  clickToken    String   @unique @map("click_token")
  referrer      String?
  landingPath   String?  @map("landing_path")
  utmSource     String?  @map("utm_source")
  utmMedium     String?  @map("utm_medium")
  utmCampaign   String?  @map("utm_campaign")
  ipHash        String?  @map("ip_hash")
  userAgentHash String?  @map("user_agent_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  partner  AffiliatePartner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  link     AffiliateLink      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  referral AffiliateReferral?

  @@index([partnerId, createdAt])
  @@index([linkId, createdAt])
  @@map("affiliate_clicks")
}

model AffiliateReferral {
  id                       String    @id @default(uuid())
  partnerId                String    @map("partner_id")
  linkId                   String?   @map("link_id")
  clickId                  String?   @unique @map("click_id")
  referredAgencyId         String    @unique @map("referred_agency_id")
  status                   String    @default("attributed")
  attributionSource        String    @default("link_cookie") @map("attribution_source")
  commissionBps            Int       @default(3000) @map("commission_bps")
  commissionDurationMonths Int       @default(12) @map("commission_duration_months")
  disqualificationReason   String?   @map("disqualification_reason")
  metadata                 Json?
  createdAt                DateTime  @default(now()) @map("created_at")
  qualifiedAt              DateTime? @map("qualified_at")
  disqualifiedAt           DateTime? @map("disqualified_at")

  partner        AffiliatePartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  link           AffiliateLink?        @relation(fields: [linkId], references: [id], onDelete: SetNull)
  click          AffiliateClick?       @relation(fields: [clickId], references: [id], onDelete: SetNull)
  referredAgency Agency                @relation(fields: [referredAgencyId], references: [id], onDelete: Cascade)
  commissions    AffiliateCommission[]

  @@index([partnerId, status])
  @@map("affiliate_referrals")
}

model AffiliatePayoutBatch {
  id              String    @id @default(uuid())
  status          String    @default("draft")
  currency        String    @default("usd")
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  totalAmount     Int       @default(0) @map("total_amount")
  commissionCount Int       @default(0) @map("commission_count")
  notes           String?   @db.Text
  exportedAt      DateTime? @map("exported_at")
  paidAt          DateTime? @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  commissions AffiliateCommission[]

  @@index([status, periodStart])
  @@map("affiliate_payout_batches")
}

model AffiliateCommission {
  id             String    @id @default(uuid())
  partnerId      String    @map("partner_id")
  referralId     String    @map("referral_id")
  subscriptionId String?   @map("subscription_id")
  invoiceId      String?   @unique @map("invoice_id")
  payoutBatchId  String?   @map("payout_batch_id")
  status         String    @default("pending")
  currency       String    @default("usd")
  amount         Int
  revenueAmount  Int       @map("revenue_amount")
  commissionBps  Int       @map("commission_bps")
  holdUntil      DateTime  @map("hold_until")
  notes          String?   @db.Text
  approvedAt     DateTime? @map("approved_at")
  paidAt         DateTime? @map("paid_at")
  voidedAt       DateTime? @map("voided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  partner      AffiliatePartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referral     AffiliateReferral     @relation(fields: [referralId], references: [id], onDelete: Cascade)
  subscription Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payoutBatch  AffiliatePayoutBatch? @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([referralId, status])
  @@index([payoutBatchId, status])
  @@map("affiliate_commissions")
}

// ============================================================
// OAUTH STATE AND PKCE STORAGE (Redis replacement)
// ============================================================

/// OAuth state tokens for CSRF protection during OAuth flows.
/// Replaces Redis-based storage with Postgres for durability.
model OAuthStateToken {
  id          String  @id @default(uuid())
  stateToken  String  @unique @map("state_token")
  agencyId    String? @map("agency_id")
  platform    String
  userEmail   String? @map("user_email")
  redirectUrl String? @map("redirect_url")

  // For client authorization flows
  accessRequestId    String? @map("access_request_id")
  accessRequestToken String? @map("access_request_token")
  clientEmail        String? @map("client_email")

  // Platform-specific parameters (e.g., Shopify shop name)
  shop     String?
  metadata Json?

  // Security
  signature String // HMAC signature for tamper prevention
  timestamp BigInt @map("timestamp") // Unix timestamp in milliseconds

  // TTL and single-use
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([stateToken, expiresAt])
  @@index([expiresAt, consumedAt]) // For cleanup queries
  @@map("oauth_state_tokens")
}

/// PKCE code verifiers for OAuth flows requiring PKCE (e.g., Klaviyo).
/// Replaces Redis-based storage with Postgres for durability.
model PkceVerifier {
  id       String @id @default(uuid())
  stateKey String @unique @map("state_key") // OAuth state used as key
  verifier String // PKCE code verifier

  // TTL and single-use
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([stateKey, expiresAt])
  @@index([expiresAt, consumedAt]) // For cleanup queries
  @@map("pkce_verifiers")
}
