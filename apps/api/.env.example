# Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
API_URL=http://localhost:3001

# Database (Neon PostgreSQL)
# Production DATABASE_URL uses pooled host (...-pooler.c-2.us-east-1.aws.neon.tech) and sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/agency_access
# Direct (unpooled) connection string for Prisma migrations (must NOT include -pooler)
DIRECT_URL=postgresql://user:password@localhost:5432/agency_access
MIGRATE_DATABASE_URL=postgresql://user:password@localhost:5432/agency_access

# Background Workers
# Set to false for pre-launch/staging with zero traffic.
# Token refresh, notifications, webhooks will not process when disabled.
BACKGROUND_WORKERS_ENABLED=true

# Infisical (Secrets Management)
INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_ENVIRONMENT=dev

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key_here
CLERK_SECRET_KEY=sk_live_your_secret_key_here
CLERK_OAUTH_ISSUER=https://your-instance.clerk.accounts.dev

# External personal-agent access (design-partner gate)
AGENT_NATIVE_ENABLED=false
AGENT_NATIVE_AGENCY_ALLOWLIST=
AGENT_MCP_RESOURCE_URL=http://localhost:3001/mcp
CLERK_OAUTH_VERIFY_URL=https://api.clerk.com/v1/oauth_applications/access_tokens/verify
AGENT_READ_RATE_LIMIT=120
AGENT_MUTATION_RATE_LIMIT=30
AGENT_AGENCY_RATE_LIMIT=300
AGENT_RATE_LIMIT_WINDOW_SECONDS=60

# Platform Credentials (OAuth)

# Meta
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_LOGIN_FOR_BUSINESS_CONFIG_ID=your-facebook-login-for-business-config-id

# Kit (ConvertKit)
KIT_CLIENT_ID=your-client-id
KIT_CLIENT_SECRET=your-client-secret

# Beehiiv (Agency API Key - for team invitation workflow)
BEEHIIV_API_KEY=your-agency-api-key

# Google (Ads, GA4)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your-manager-customer-id-without-dashes

# LinkedIn
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

# TikTok
# Preferred (new)
TIKTOK_CLIENT_ID=your-client-id
TIKTOK_CLIENT_SECRET=your-client-secret
# Legacy aliases (still supported)
TIKTOK_APP_ID=your-app-id
TIKTOK_APP_SECRET=your-app-secret

# Mailchimp
MAILCHIMP_CLIENT_ID=your-client-id
MAILCHIMP_CLIENT_SECRET=your-client-secret

# Pinterest OAuth
# Note: Pinterest Business ID is collected from users during authorization flow
PINTEREST_CLIENT_ID=your-app-id
PINTEREST_CLIENT_SECRET=your-app-secret

# Klaviyo
KLAVIYO_CLIENT_ID=your-public-api-key
KLAVIYO_CLIENT_SECRET=your-private-api-key

# Shopify
SHOPIFY_API_KEY=your-api-key
SHOPIFY_API_SECRET_KEY=your-api-secret-key

# Zapier
ZAPIER_CLIENT_ID=your_zapier_client_id_here
ZAPIER_CLIENT_SECRET=your_zapier_client_secret_here

# Creem Payments
CREEM_API_KEY=creem_live_your_api_key_here
CREEM_WEBHOOK_SECRET=whsec_your_webhook_secret_here
CREEM_API_URL=https://api.creem.io

# PostHog (server-side subscription lifecycle events)
POSTHOG_API_KEY=phc_your_project_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Resend Email Service
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=AuthHub <notifications@notifications.authhub.co>
RESEND_REPLY_TO_EMAIL=support@authhub.co

# Help Scout Beacon secure mode
HELPSCOUT_BEACON_SECRET=

# Logging
LOG_LEVEL=info

# Security Configuration

# Rate Limiting (prevents DoS/brute force attacks)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_TIME_WINDOW_SECONDS=60
RATE_LIMIT_SKIP_AUTHENTICATED=true

# Dashboard performance controls
# When true, /api/dashboard returns bounded summary lists with truncation metadata.
DASHBOARD_SUMMARY_LIMITS_ENABLED=true

# Trusted proxy IP/CIDR allowlist for deriving client IP (comma-separated)
# Example: 127.0.0.1,10.0.0.0/8,192.168.0.0/16
TRUST_PROXY_IPS=

# Optional strict DB least-privilege check for production startup
# When true, blocks elevated DB users (postgres/neondb_owner/root/admin)
DB_ENFORCE_LEAST_PRIVILEGE=false

# OAuth State Security (HMAC signing for CSRF protection)
# Generate with: openssl rand -hex 32
# Required in production; startup fails if missing or shorter than 32 characters.
OAUTH_STATE_HMAC_SECRET=your-hmac-secret-key-32-bytes-hex-generated-with-openssl-rand-hex-32

# Internal Admin Access Control (comma-separated allowlists)
# Example: user_123,user_456
INTERNAL_ADMIN_USER_IDS=
# Example: admin@yourcompany.com,ops@yourcompany.com
INTERNAL_ADMIN_EMAILS=

# Affiliate Program
AFFILIATE_COOKIE_TTL_DAYS=90
AFFILIATE_DEFAULT_COMMISSION_BPS=5000
AFFILIATE_DEFAULT_COMMISSION_MONTHS=12
AFFILIATE_DEFAULT_TRAILING_COMMISSION_BPS=3000
AFFILIATE_DEFAULT_TRAILING_COMMISSION_MONTHS=6
AFFILIATE_HOLD_DAYS=30
AFFILIATE_PORTAL_ENABLED=false

# Google Client Offboarding (feature-flagged, design-partner gate)
# Disabled by default. Enable only for design-partner agencies during rollout.
GOOGLE_CLIENT_OFFBOARDING_ENABLED=false
# Comma-separated agency IDs allowed to use offboarding. Empty = none allowed.
GOOGLE_CLIENT_OFFBOARDING_ALLOWED_AGENCIES=
# GA4 adapter behind its own flag. Requires GOOGLE_ADS_DEVELOPER_TOKEN when enabled.
GOOGLE_CLIENT_OFFBOARDING_GA4_ENABLED=false
# HMAC secret for offboarding capability tokens. Required when offboarding is enabled.
OFFBOARDING_CAPABILITY_SECRET=

# Outbound Webhooks
WEBHOOK_DELIVERY_TIMEOUT_MS=5000
WEBHOOK_FAILURE_DISABLE_THRESHOLD=5
WEBHOOK_MAX_ATTEMPTS=6

# Sentry Error Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_SEND_IN_DEV=false
# Required when Sentry webhooks are enabled in production; "skip" and "disabled" are local-only.
SENTRY_WEBHOOK_SECRET=your-webhook-secret-for-signature-verification
SENTRY_AUTH_TOKEN=sntrys_your-auth-token-here
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=node
