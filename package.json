{
  "name": "agency-access-platform",
  "version": "0.1.0",
  "private": true,
  "description": "OAuth aggregation platform for marketing agencies",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:docs": "npm run dev --workspace=apps/docs",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:design-os": "cd tools/design-os && npm run dev",
    "design-os": "bash ./scripts/start-design-os.sh",
    "design-os:quick": "bash ./scripts/design-os.sh",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "build:docs": "npm run build --workspace=apps/docs",
    "build:web": "npm run build --workspace=packages/shared && npm run build --workspace=apps/web",
    "build:design-os": "cd tools/design-os && npm run build",
    "lint": "npm run lint --workspace=apps/api && npm run lint --workspace=apps/web",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:docs": "npm run typecheck --workspace=apps/docs",
    "perf:api": "node scripts/perf/benchmark-api.mjs",
    "perf:browser": "node scripts/perf/benchmark-browser.mjs",
    "perf:report": "node scripts/perf/generate-report.mjs",
    "perf:dashboard:gate": "node scripts/perf/benchmark-api.mjs --enforce-budget true",
    "perf:web:inp-smoke": "bash scripts/perf/web-inp-smoke.sh"
  },
  "devDependencies": {
    "@googleworkspace/cli": "^0.11.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/otlp-exporter-base": "^0.219.0",
    "@opentelemetry/otlp-transformer": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "axios": "^1.13.5",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "svix": "^1.96.0",
    "react-router": "^5.3.4"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  }
}
